RewriteRule ^side-hustles/side-hustle-client-acquisition-system-canada/?$ /side-hustles/side-hustle-admin-tools-checklist-canada/ [R=301,L]
RewriteRule ^side-hustles/side-hustle-waitlist-canada/?$ /side-hustles/side-hustle-admin-tools-checklist-canada/ [R=301,L]
