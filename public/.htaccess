# Make Money Optimizer — Hostinger/Apache helpers
Options -Indexes

# Serve extensionless URLs when using file format fallbacks
RewriteEngine On

# Force HTTPS if available (Hostinger often handles this in panel; keep harmless)
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# If request has no extension and isn't a directory, try .html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# Retired sample slugs. Tutoring, writing, and reselling have full guides.
# Gig delivery stays pointed at the side-hustles hub.
RewriteRule ^side-hustles/online-tutoring-canada/?$ /side-hustles/online-tutoring-side-hustle-canada [R=301,L]
RewriteRule ^side-hustles/freelance-writing-canada/?$ /side-hustles/freelance-writing-side-hustle-canada [R=301,L]
RewriteRule ^side-hustles/reselling-marketplace-canada/?$ /side-hustles/reselling-side-hustle-canada [R=301,L]
RewriteRule ^side-hustles/gig-delivery-canada/?$ /side-hustles [R=301,L]

# Prefer apex canonical is configured in Hostinger DNS/panel
