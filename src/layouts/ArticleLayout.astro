---
import BaseLayout from './BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import Newsletter from '../components/Newsletter.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import Sources from '../components/Sources.astro';
import AuthorBox from '../components/AuthorBox.astro';
import { AUTHOR, SITE, authorSameAs, authorUrl } from '../lib/site';
import { getPublishedArticles, relatedArticles } from '../lib/articles';

interface SourceItem {
  title: string;
  url: string;
  publisher: string;
}

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  updateNote?: string;
  sources?: SourceItem[];
  category: string;
  tags?: string[];
  sample?: boolean;
  entryId: string;
  slug: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  updateNote,
  sources = [],
  category,
  tags = [],
  sample = false,
  entryId,
  slug,
} = Astro.props;

const all = await getPublishedArticles();
const related = relatedArticles(all, entryId, 3);
const url = `${SITE.url}/side-hustles/${slug}`;
const categoryLabel = category === 'guide' ? 'Guide' : 'Side Hustle';
const image = new URL('/og-default.svg', SITE.url).toString();
const dateModified = updatedDate || pubDate;

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric' });

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  image,
  datePublished: pubDate.toISOString(),
  dateModified: dateModified.toISOString(),
  author: {
    '@type': 'Person',
    name: AUTHOR.name,
    url: authorUrl,
    sameAs: authorSameAs,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  inLanguage: 'en-CA',
  keywords: tags.join(', '),
  about: categoryLabel,
  isAccessibleForFree: true,
};
---
<BaseLayout
  title={title}
  description={description}
  ogType="article"
  author={AUTHOR.name}
  publishedTime={pubDate.toISOString()}
  modifiedTime={dateModified.toISOString()}
  jsonLd={articleJsonLd}
>
  <header class="article-hero">
    <div class="container-narrow">
      <div class="article-meta">
        <a href={category === 'guide' ? '/guides' : '/side-hustles'}>{categoryLabel}</a>
        {sample && <span class="badge badge-sample">Sample article</span>}
      </div>
      <h1>{title}</h1>
      <p class="byline">
        By <a href={AUTHOR.path}>{AUTHOR.name}</a>
      </p>
      <p class="article-dates">
        <span>
          Published <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        </span>
        {
          updatedDate && (
            <span>
              Updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
              {updateNote ? `: ${updateNote}` : ''}
            </span>
          )
        }
      </p>
      <p class="ai-note">
        Researched and drafted with AI assistance and checked against the official sources listed below.
        <a href="/how-we-create-content">How we create content</a>
      </p>
      {tags.length > 0 && (
        <div class="card-meta" style="margin-top:1rem;">
          {tags.map((tag) => (
            <a class="chip" href={`/side-hustles?tag=${encodeURIComponent(tag)}`}>#{tag}</a>
          ))}
        </div>
      )}
    </div>
  </header>

  <AdSlot class="container ad-slot-inline" label="Ad slot · article top" />

  <article class="section" style="padding-top:var(--space-8);">
    <div class="container-narrow prose">
      <slot />
      <Sources sources={sources} />
      <AuthorBox />
    </div>
  </article>

  <AdSlot class="container ad-slot-inline" label="Ad slot · article mid" />

  <div class="container" style="margin-bottom:var(--space-12);">
    <Newsletter heading="Want more like this?" />
  </div>

  <RelatedArticles articles={related} heading="Related for Canadian readers" />

  <div class="container" style="margin-bottom:var(--space-12);">
    <div class="callout">
      <p>
        <strong>Trust note:</strong> This is educational content for Canadians exploring extra income.
        Earnings vary widely. We don’t guarantee results. Check CRA rules for your situation, and read our
        <a href="/affiliate-disclosure">Affiliate Disclosure</a> and
        <a href="/how-we-create-content">how we create content</a>.
      </p>
    </div>
  </div>
</BaseLayout>
