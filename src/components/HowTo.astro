---
/**
 * Visible step list plus HowTo JSON-LD.
 * Use only when the guide is a real procedure. The steps must restate
 * instructions already in the article. Do not use it on roundups or listicles.
 */
interface HowToStep {
  name: string;
  text: string;
}

interface Props {
  name: string;
  description: string;
  steps: HowToStep[];
}

const { name, description, steps } = Astro.props;

if (steps.length < 3 || steps.length > 8) {
  throw new Error(`HowTo "${name}" must contain 3–8 steps (got ${steps.length}).`);
}

for (const step of steps) {
  if (!step.name?.trim() || !step.text?.trim()) {
    throw new Error(`HowTo "${name}" has a step with an empty name or text.`);
  }
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name,
  description,
  inLanguage: 'en-CA',
  step: steps.map((step, index) => ({
    '@type': 'HowToStep',
    position: index + 1,
    name: step.name,
    text: step.text,
  })),
};
---

<aside class="howto-glance" aria-label={name}>
  <p class="howto-label">Steps at a glance</p>
  <p>{description}</p>
  <ol>
    {
      steps.map((step) => (
        <li>
          <strong>{step.name}.</strong> {step.text}
        </li>
      ))
    }
  </ol>
</aside>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
