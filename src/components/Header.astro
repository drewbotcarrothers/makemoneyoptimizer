---
import { SITE, NAV } from '../lib/site';
import { CATEGORIES, CATEGORIES_INDEX, categoryHref } from '../lib/categories';
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

const inCategories = pathname === CATEGORIES_INDEX || pathname.startsWith('/side-hustles/category/');

function isCurrent(href: string) {
  if (href === '/') return pathname === '/';
  if (href === CATEGORIES_INDEX) return inCategories;
  if (href === '/side-hustles' && inCategories) return false;
  return pathname === href || pathname.startsWith(`${href}/`);
}
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${SITE.name} home`}>
      <picture>
        <source
          type="image/webp"
          srcset="/beaver-header.webp 1x, /beaver-header@2x.webp 2x"
        />
        <img
          class="brand-logo"
          src="/beaver-header.png"
          srcset="/beaver-header.png 1x, /beaver-header@2x.png 2x"
          alt={`${SITE.name} logo: a friendly beaver waving and holding Canadian bills`}
          width="48"
          height="48"
          decoding="async"
        />
      </picture>
      <span class="brand-text">{SITE.name}</span>
    </a>

    <nav class="nav" aria-label="Primary">
      {NAV.map((item) =>
        item.href === CATEGORIES_INDEX ? (
          <div class="nav-dropdown">
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined} aria-haspopup="true">
              {item.label} <span class="nav-caret" aria-hidden="true">▾</span>
            </a>
            <div class="nav-dropdown-menu">
              {CATEGORIES.map((c) => (
                <a
                  href={categoryHref(c.slug)}
                  aria-current={pathname === categoryHref(c.slug) ? 'page' : undefined}
                >
                  <span aria-hidden="true">{c.emoji}</span> {c.name}
                </a>
              ))}
              <a class="nav-dropdown-all" href={CATEGORIES_INDEX}>All categories →</a>
            </div>
          </div>
        ) : (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        )
      )}
    </nav>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Open menu"
      data-nav-toggle
    >
      <span aria-hidden="true"></span>
    </button>
  </div>
  <nav id="mobile-nav" class="nav-mobile container" aria-label="Mobile" data-mobile-nav>
    {NAV.map((item) => (
      <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
        {item.label}
      </a>
    ))}
  </nav>
</header>

<script>
  const toggle = document.querySelector('[data-nav-toggle]');
  const menu = document.querySelector('[data-mobile-nav]');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const open = menu.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    });
  }
</script>
