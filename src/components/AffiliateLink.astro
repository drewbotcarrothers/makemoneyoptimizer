---
import {
  affiliateHref,
  isAffiliateApproved,
  type AffiliateProgram,
} from '../lib/affiliate-placeholders';

interface Props {
  program: AffiliateProgram;
  label: string;
  /**
   * Amazon.ca only: verified ASIN of the named product. Links to
   * amazon.ca/dp/<ASIN>?tag=makemoneyoptimizer-20. Never guess an ASIN.
   */
  asin?: string;
  /**
   * Amazon.ca only: search keywords for generic categories. Used when there is
   * no `asin`; links to amazon.ca/s?k=<keywords>&tag=makemoneyoptimizer-20.
   */
  search?: string;
}

const { program, label, asin, search } = Astro.props;
const href = affiliateHref(program, { asin, search });
const approved = isAffiliateApproved(program);
---

{approved ? (
  <a
    href={href}
    data-affiliate={program}
    data-program={program}
    rel="sponsored nofollow noopener"
    target="_blank"
  >
    {label}
  </a>
) : (
  <a href={href} rel="noopener noreferrer" target="_blank">
    {label}
  </a>
)}
