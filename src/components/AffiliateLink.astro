---
import {
  affiliateHref,
  isAffiliateApproved,
  type AffiliateProgram,
} from '../lib/affiliate-placeholders';

interface Props {
  program: AffiliateProgram;
  label: string;
  /**
   * Optional product keywords for Amazon.ca mentions. Kept for editorial
   * context; the approved Amazon Associates entry link does not use them.
   */
  search?: string;
}

const { program, label, search } = Astro.props;
const href = affiliateHref(program, search);
const approved = isAffiliateApproved(program);
---

{approved ? (
  <a
    href={href}
    data-affiliate={program}
    data-program={program}
    rel="sponsored nofollow noopener"
    target="_blank"
  >
    {label}
  </a>
) : (
  <a href={href} rel="noopener noreferrer" target="_blank">
    {label}
  </a>
)}
