---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import Newsletter from '../../components/Newsletter.astro';
import { getPublishedArticles } from '../../lib/articles';
import CategoryGrid from '../../components/CategoryGrid.astro';
import { CATEGORIES_INDEX, categoryCounts, categoryHref } from '../../lib/categories';

const articles = await getPublishedArticles();
// Every article is a how-to guide; show the newest here and route readers to category hubs.
const guides = articles.slice(0, 9);
const cats = categoryCounts(articles);
const taxGuides = articles.filter((a) => a.data.category === 'taxes-money').slice(0, 3);

const pageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Side Income Guides for Canadians',
  description: 'Practical guides to evaluate and test side income ideas in Canada.',
  url: 'https://makemoneyoptimizer.com/guides/',
};
---
<BaseLayout
  title="Guides for Canadian Side Income"
  description="Practical guides for Canadians testing side income — frameworks, checklists, and ethical how-tos that pair with our side hustle articles."
  jsonLd={pageJsonLd}
>
  <header class="page-hero">
    <div class="container">
      <p class="eyebrow">Guides</p>
      <h1>How-to guidance without the hype</h1>
      <p class="lead">
        Guides focus on process: evaluating fit, setting boundaries, and testing ideas responsibly. Pair them with the <a href="/side-hustles/">Side Hustles hub</a> for specific paths. If you are choosing work this month, open <a href="/side-hustles/dog-walking-side-hustle-canada/">dog walking</a>, <a href="/side-hustles/snow-blower-buying-guide-canada/">the snow blower buying guide</a>, <a href="/side-hustles/backyard-rink-flooding-side-hustle-canada/">backyard rink care</a>, <a href="/side-hustles/online-tutoring-side-hustle-canada/">online tutoring</a>, or <a href="/side-hustles/freelance-writing-side-hustle-canada/">freelance writing</a>. Hosting is in <a href="/side-hustles/hostinger-vs-namecheap-vs-wordpress-com-canada/">Hostinger vs Namecheap vs WordPress.com</a>, and a printer or engraver purchase starts with the <a href="/side-hustles/3d-printer-laser-engraver-buying-guide-canada/">buying guide</a>. Tax paperwork is the <a href="/free-side-hustle-tax-checklist/">free checklist</a> plus <a href="/side-hustles/t4a-t5018-platform-slips-side-hustle-canada/">platform slips</a>.
      </p>
    </div>
  </header>

  <AdSlot class="container ad-slot-inline" label="Ad slot · guides hub" />

  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <h2>Browse guides by category</h2>
          <p>Every guide lives in one category. Start with the kind of work that fits you.</p>
        </div>
        <a class="btn btn-secondary" href={CATEGORIES_INDEX}>All categories</a>
      </div>
      <CategoryGrid categories={cats} />
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container">
      <div class="section-header">
        <div>
          <h2>Latest guides</h2>
          <p>Step-by-step playbooks for Canadian side income. Start with one, then compare a neighbouring hustle.</p>
        </div>
        <a class="btn btn-secondary" href="/side-hustles/">All guides</a>
      </div>
      {guides.length === 0 ? (
        <p>Guides are on the way. Meanwhile explore <a href="/side-hustles/">side hustles</a>.</p>
      ) : (
        <div class="card-grid cols-3">
          {guides.map((a) => (
            <ArticleCard
              href={`/side-hustles/${a.slug}/`}
              title={a.data.title}
              description={a.data.description}
              category={a.data.category}
              tags={a.data.tags}
              sample={a.data.sample}
              date={a.data.pubDate}
            />
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="section section-muted">
    <div class="container">
      <div class="section-header">
        <div>
          <h2>Taxes &amp; money basics</h2>
          <p>CRA reporting, GST/HST, and deductions every Canadian side hustler should understand.</p>
        </div>
        <a class="btn btn-secondary" href={categoryHref('taxes-money')}>All tax guides</a>
      </div>
      <div class="card-grid cols-3">
        {taxGuides.map((a) => (
          <ArticleCard
            href={`/side-hustles/${a.slug}/`}
            title={a.data.title}
            description={a.data.description}
            category={a.data.category}
            tags={a.data.tags}
            sample={a.data.sample}
            date={a.data.pubDate}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container">
      <Newsletter />
    </div>
  </section>
</BaseLayout>
