---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CategoryGrid from '../../components/CategoryGrid.astro';
import { getPublishedArticles } from '../../lib/articles';
import { CATEGORIES_INDEX, breadcrumbJsonLd, categoryCounts, categoryHref } from '../../lib/categories';
import { SITE } from '../../lib/site';

const all = await getPublishedArticles();
const cats = categoryCounts(all);

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Side Hustles', href: '/side-hustles' },
  { name: 'Categories', href: CATEGORIES_INDEX },
];

const title = 'Side Hustle Categories for Canadians';
const description =
  'Browse Canadian side hustle guides by category: gig apps, local services, online freelancing, digital products, content creation, reselling, marketing, tech and AI, and taxes.';

const collectionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  url: `${SITE.url}${CATEGORIES_INDEX}`,
  inLanguage: 'en-CA',
  isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: cats.length,
    itemListElement: cats.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${SITE.url}${categoryHref(c.slug)}`,
      name: c.name,
    })),
  },
};
---
<BaseLayout title={title} description={description} jsonLd={[collectionJsonLd, breadcrumbJsonLd(crumbs, SITE.url)]}>
  <header class="page-hero">
    <div class="container">
      <Breadcrumbs crumbs={crumbs} />
      <p class="eyebrow">Browse by category</p>
      <h1>Side hustle categories</h1>
      <p class="lead">
        Pick the kind of work that suits your time, skills, and budget. Every category collects our Canadian guides
        on getting started, startup costs, and finding first clients, plus a Taxes &amp; Money section for CRA basics.
      </p>
      <p class="post-count">{all.length} guides across {cats.length} categories</p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <CategoryGrid categories={cats} headingLevel="h2" />
    </div>
  </section>
</BaseLayout>
