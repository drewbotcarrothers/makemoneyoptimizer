---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import AdSlot from '../components/AdSlot.astro';
import Newsletter from '../components/Newsletter.astro';
import { SITE } from '../lib/site';
import { getPublishedArticles } from '../lib/articles';
import CategoryGrid from '../components/CategoryGrid.astro';
import { CATEGORIES_INDEX, categoryCounts } from '../lib/categories';

const articles = await getPublishedArticles();
const featured = articles.filter((a) => a.data.featured).slice(0, 3);
const latest = articles.slice(0, 3);
const cats = categoryCounts(articles);

const pageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: `${SITE.name} — ${SITE.tagline}`,
  description: SITE.description,
  url: `${SITE.url}/`,
  isPartOf: { '@type': 'WebSite', name: SITE.name, url: `${SITE.url}/` },
};
---
<BaseLayout
  title={`${SITE.name} — Practical Side Hustles for Canadians`}
  description={SITE.description}
  jsonLd={pageJsonLd}
>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Canadian-focused · Ethical · Practical</p>
        <h1>Side income guidance you can actually use</h1>
        <p class="lead">
          Make Money Optimizer helps Canadians evaluate online and offline side hustles with clear trade-offs,
          realistic expectations, and trust-first advice — no fake earnings screenshots, no “guaranteed income.”
        </p>
        <div class="btn-group" style="margin-top:1.5rem;">
          <a class="btn btn-primary" href="/start-here/">New? Start here</a>
          <a class="btn btn-secondary" href="/side-hustles/">Browse side hustles</a>
        </div>
        <div class="trust-row">
          <span><strong>Built for CA readers</strong> — local angles & admin notes</span>
          <span><strong>Sample content live</strong> — expand as we publish</span>
        </div>
      </div>
      <aside class="hero-card" aria-labelledby="how-heading">
        <h2 id="how-heading">How we help you decide</h2>
        <ol>
          <li>Skim hustles that match your time, skills, and risk comfort.</li>
          <li>Read guides that cover costs, boundaries, and Canadian admin basics.</li>
          <li>Test small, measure honestly, and keep what fits your life.</li>
        </ol>
        <p style="margin:1.25rem 0 0;font-size:0.875rem;color:var(--color-ink-subtle);">
          New here? Read <a href="/start-here/">how to pick your first side hustle</a>, the
          <a href="/side-hustles/snow-removal-side-hustle-canada/">snow removal guide</a>,
          or the <a href="/side-hustles/best-winter-side-hustles-canada/">winter side hustles roundup</a>.
        </p>
      </aside>
    </div>
  </section>

  <AdSlot class="container ad-slot-inline" label="Ad slot · home below hero" />

  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <h2>Featured side hustles & guides</h2>
          <p>Hand-picked, in-depth guides with Canadian costs, rules, and sources.</p>
        </div>
        <a class="btn btn-secondary" href="/side-hustles/">View all</a>
      </div>
      <div class="card-grid cols-3">
        {featured.map((a) => (
          <ArticleCard
            href={`/side-hustles/${a.slug}/`}
            title={a.data.title}
            description={a.data.description}
            category={a.data.category}
            tags={a.data.tags}
            sample={a.data.sample}
            date={a.data.pubDate}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section section-muted" aria-labelledby="browse-categories-heading">
    <div class="container">
      <div class="section-header">
        <div>
          <h2 id="browse-categories-heading">Browse by category</h2>
          <p>Pick the kind of work that fits your time, skills, and budget, from gig apps to taxes.</p>
        </div>
        <a class="btn btn-secondary" href={CATEGORIES_INDEX}>All categories</a>
      </div>
      <CategoryGrid categories={cats} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <h2>Explore by path</h2>
          <p>Category hubs make it easy to browse more than one idea without bouncing.</p>
        </div>
      </div>
      <div class="card-grid cols-3">
        <a class="card" href="/side-hustles/">
          <span class="badge">Hub</span>
          <h3>Side Hustles</h3>
          <p>Online and offline ways to earn extra — freelancing, reselling, gigs, tutoring, and more.</p>
          <span class="card-link">Open hub →</span>
        </a>
        <a class="card" href="/guides/">
          <span class="badge">Hub</span>
          <h3>Guides</h3>
          <p>How-to frameworks, checklists, and decision help so you can test ideas responsibly.</p>
          <span class="card-link">Open guides →</span>
        </a>
        <a class="card" href="/contact/">
          <span class="badge">Trust</span>
          <h3>Questions or feedback?</h3>
          <p>Tell us what Canadian side-income topics you want covered next.</p>
          <span class="card-link">Contact us →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <h2>Latest on the site</h2>
          <p>Fresh reads and internal links to keep exploring.</p>
        </div>
      </div>
      <div class="card-grid cols-3">
        {latest.map((a) => (
          <ArticleCard
            href={`/side-hustles/${a.slug}/`}
            title={a.data.title}
            description={a.data.description}
            category={a.data.category}
            tags={a.data.tags}
            sample={a.data.sample}
            date={a.data.pubDate}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container">
      <Newsletter />
    </div>
  </section>
</BaseLayout>
