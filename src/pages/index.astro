---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import AdSlot from '../components/AdSlot.astro';
import Newsletter from '../components/Newsletter.astro';
import { SITE } from '../lib/site';
import { getPublishedArticles } from '../lib/articles';
import CategoryGrid from '../components/CategoryGrid.astro';
import { CATEGORIES_INDEX, categoryCounts } from '../lib/categories';

const articles = await getPublishedArticles();
const featured = articles.filter((a) => a.data.featured).slice(0, 3);
const latest = articles.slice(0, 3);
const cats = categoryCounts(articles);

const pageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: `${SITE.name} — ${SITE.tagline}`,
  description: SITE.description,
  url: `${SITE.url}/`,
  isPartOf: { '@type': 'WebSite', name: SITE.name, url: `${SITE.url}/` },
};
---
<BaseLayout
  title={`${SITE.name} — Practical Side Hustles for Canadians`}
  description={SITE.description}
  jsonLd={pageJsonLd}
>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Canadian-focused · Ethical · Practical</p>
        <h1>Side income guidance you can actually use</h1>
        <p class="lead">
          Make Money Optimizer helps Canadians evaluate online and offline side hustles with clear trade-offs,
          realistic expectations, and trust-first advice — no fake earnings screenshots, no “guaranteed income.”
        </p>
        <div class="btn-group" style="margin-top:1.5rem;">
          <a class="btn btn-primary" href="/start-here/">New? Start here</a>
          <a class="btn btn-secondary" href="/side-hustles/">Browse side hustles</a>
        </div>
        <div class="trust-row">
          <span><strong>Built for CA readers</strong> — local angles & admin notes</span>
          <span><strong>Sample content live</strong> — expand as we publish</span>
        </div>
      </div>
      <aside class="hero-card" aria-labelledby="how-heading">
        <h2 id="how-heading">How we help you decide</h2>
        <ol>
          <li>Skim hustles that match your time, skills, and risk comfort.</li>
          <li>Read guides that cover costs, boundaries, and Canadian admin basics.</li>
          <li>Test small, measure honestly, and keep what fits your life.</li>
        </ol>
        <p style="margin:1.25rem 0 0;font-size:0.875rem;color:var(--color-ink-subtle);">
          New here? Read <a href="/start-here/">how to pick your first side hustle</a>, the
          <a href="/side-hustles/snow-removal-side-hustle-canada/">snow removal guide</a>,
          or the <a href="/side-hustles/best-winter-side-hustles-canada/">winter side hustles roundup</a>.
        </p>
      </aside>
    </div>
  </section>

  <AdSlot class="container ad-slot-inline" label="Ad slot · home below hero" />

  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <h2>Featured side hustles & guides</h2>
          <p>Hand-picked, in-depth guides with Canadian costs, rules, and sources.</p>
        </div>
        <a class="btn btn-secondary" href="/side-hustles/">View all</a>
      </div>
      <div class="card-grid cols-3">
        {featured.map((a) => (
          <ArticleCard
            href={`/side-hustles/${a.slug}/`}
            title={a.data.title}
            description={a.data.description}
            category={a.data.category}
            tags={a.data.tags}
            sample={a.data.sample}
            date={a.data.pubDate}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section section-muted" aria-labelledby="browse-categories-heading">
    <div class="container">
      <div class="section-header">
        <div>
          <h2 id="browse-categories-heading">Browse by category</h2>
          <p>Pick the kind of work that fits your time, skills, and budget, from gig apps to taxes.</p>
        </div>
        <a class="btn btn-secondary" href={CATEGORIES_INDEX}>All categories</a>
      </div>
      <CategoryGrid categories={cats} />
    </div>
  </section>

  <section class="section">
    <div class="container-narrow prose">
      <h2>Next steps from the guides readers open first</h2>
      <p>
        Winter routes and delivery apps are the guides most people open first. From <a href="/side-hustles/snow-removal-side-hustle-canada/">snow removal</a>, the next read is the <a href="/side-hustles/snow-blower-buying-guide-canada/">snow blower buying guide</a> once a shovel route is too slow, or <a href="/side-hustles/dog-walking-side-hustle-canada/">dog walking</a> if you want a sidewalk route without a truck. Neighbours who already own a sheet are in <a href="/side-hustles/backyard-rink-flooding-side-hustle-canada/">backyard rink care</a>. The season overview is <a href="/side-hustles/best-winter-side-hustles-canada/">best winter side hustles</a>.
      </p>
      <p>
        Couriers comparing apps should read <a href="/side-hustles/uber-eats-vs-doordash-vs-skip-canada/">Uber Eats vs DoorDash vs Skip</a>, then <a href="/side-hustles/t4a-t5018-platform-slips-side-hustle-canada/">T4A, T5018 and platform slips</a> before filing. A blog starts with <a href="/side-hustles/seo-blogging-side-hustle-canada/">SEO blogging</a> and <a href="/side-hustles/hostinger-vs-namecheap-vs-wordpress-com-canada/">Hostinger vs Namecheap vs WordPress.com</a>. A skill you already have points to <a href="/side-hustles/freelance-writing-side-hustle-canada/">freelance writing</a> or <a href="/side-hustles/online-tutoring-side-hustle-canada/">online tutoring</a>. A machine purchase starts with the <a href="/side-hustles/3d-printer-laser-engraver-buying-guide-canada/">3D printer and laser engraver buying guide</a>, not the first ad.
      </p>
      <p>
        Keep records with the <a href="/free-side-hustle-tax-checklist/">free side hustle tax checklist</a>, compare filing tools in <a href="/side-hustles/wealthsimple-tax-vs-turbotax-vs-hr-block-canada/">Wealthsimple Tax vs TurboTax vs H&amp;R Block</a>, and treat any pitch that asks you to pay for a job as a <a href="/side-hustles/side-hustle-scams-canada/">side hustle scam</a> until it proves otherwise. The hubs those guides live in are <a href="/side-hustles/category/local-services/">local services</a>, <a href="/side-hustles/category/online-freelancing/">online freelancing</a>, <a href="/side-hustles/category/content-creation/">content creation</a>, <a href="/side-hustles/category/digital-products/">digital products</a>, <a href="/side-hustles/category/reselling-ecommerce/">reselling</a>, <a href="/side-hustles/category/marketing-for-hire/">marketing for hire</a>, <a href="/side-hustles/category/tech-ai/">tech and AI</a>, and <a href="/side-hustles/category/taxes-money/">taxes and money</a>. Who writes the guides is on <a href="/about/andrew/">Andrew</a>. The site overview is <a href="/about/">about</a>, and questions go to <a href="/contact/">contact</a>.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <h2>Explore by path</h2>
          <p>Category hubs make it easy to browse more than one idea without bouncing.</p>
        </div>
      </div>
      <div class="card-grid cols-3">
        <a class="card" href="/side-hustles/">
          <span class="badge">Hub</span>
          <h3>Side Hustles</h3>
          <p>Online and offline ways to earn extra — freelancing, reselling, gigs, tutoring, and more.</p>
          <span class="card-link">Open hub →</span>
        </a>
        <a class="card" href="/guides/">
          <span class="badge">Hub</span>
          <h3>Guides</h3>
          <p>How-to frameworks, checklists, and decision help so you can test ideas responsibly.</p>
          <span class="card-link">Open guides →</span>
        </a>
        <a class="card" href="/contact/">
          <span class="badge">Trust</span>
          <h3>Questions or feedback?</h3>
          <p>Tell us what Canadian side-income topics you want covered next.</p>
          <span class="card-link">Contact us →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <h2>Latest on the site</h2>
          <p>Fresh reads and internal links to keep exploring.</p>
        </div>
      </div>
      <div class="card-grid cols-3">
        {latest.map((a) => (
          <ArticleCard
            href={`/side-hustles/${a.slug}/`}
            title={a.data.title}
            description={a.data.description}
            category={a.data.category}
            tags={a.data.tags}
            sample={a.data.sample}
            date={a.data.pubDate}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container">
      <Newsletter />
    </div>
  </section>
</BaseLayout>
